<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
    <FileHeader revMajor="1" revMinor="2" date="2026-10-25T00:00:00" description="Town10HD Autoware + esminiLib Cut-In &amp; Lead Vehicle Scenario" author="CARLA"/>
    <ParameterDeclarations>
        <ParameterDeclaration name="LeadTargetSpeed" parameterType="double" value="15.0"/>
        <ParameterDeclaration name="CutInSpeed" parameterType="double" value="11.5"/>
        <ParameterDeclaration name="TriggerDistance" parameterType="double" value="32.0"/>
    </ParameterDeclarations>
    <CatalogLocations/>
    <RoadNetwork>
        <LogicFile filepath="Town10HD_Opt.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="ego">
            <Vehicle name="car_ego" vehicleCategory="car">
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.75"/>
                    <Dimensions width="2.0" length="4.9" height="1.5"/>
                </BoundingBox>
                <Performance maxSpeed="60.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.7" trackWidth="1.6" positionX="2.85" positionZ="0.35"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.7" trackWidth="1.6" positionX="0.0" positionZ="0.35"/>
                </Axles>
                <Properties>
                    <Property name="carla_blueprint" value="vehicle.lincoln.mkz"/>
                    <Property name="color" value="#143CC8"/>
                </Properties>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="lead_npc">
            <Vehicle name="car_red" vehicleCategory="car">
                <BoundingBox>
                    <Center x="1.35" y="0.0" z="0.75"/>
                    <Dimensions width="1.9" length="4.7" height="1.5"/>
                </BoundingBox>
                <Performance maxSpeed="60.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.7" trackWidth="1.6" positionX="2.7" positionZ="0.35"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.7" trackWidth="1.6" positionX="0.0" positionZ="0.35"/>
                </Axles>
                <Properties>
                    <Property name="carla_blueprint" value="vehicle.tesla.model3"/>
                    <Property name="color" value="#C81414"/>
                </Properties>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="cut_in_npc">
            <Vehicle name="car_yellow" vehicleCategory="car">
                <BoundingBox>
                    <Center x="1.3" y="0.0" z="0.75"/>
                    <Dimensions width="1.85" length="4.2" height="1.45"/>
                </BoundingBox>
                <Performance maxSpeed="60.0" maxAcceleration="10.0" maxDeceleration="10.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.68" trackWidth="1.55" positionX="2.6" positionZ="0.34"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.68" trackWidth="1.55" positionX="0.0" positionZ="0.34"/>
                </Axles>
                <Properties>
                    <Property name="carla_blueprint" value="vehicle.audi.tt"/>
                    <Property name="color" value="#EBC80F"/>
                </Properties>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="sidewalk_walker">
            <Pedestrian name="walker_01" pedestrianCategory="pedestrian" model="walker" mass="75.0">
                <BoundingBox>
                    <Center x="0.0" y="0.0" z="0.9"/>
                    <Dimensions width="0.5" length="0.6" height="1.8"/>
                </BoundingBox>
                <Properties/>
            </Pedestrian>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <GlobalAction>
                    <EnvironmentAction>
                        <Environment name="ClearDayEnvironment">
                            <TimeOfDay animation="false" dateTime="2026-06-15T14:00:00"/>
                            <Weather cloudState="free">
                                <Sun illuminance="100000.0" azimuth="0.8" elevation="0.95"/>
                                <Fog visualRange="10000.0"/>
                                <Precipitation precipitationType="dry" precipitationIntensity="0.0"/>
                            </Weather>
                            <RoadCondition frictionScaleFactor="1.0"/>
                        </Environment>
                    </EnvironmentAction>
                </GlobalAction>
                <Private entityRef="ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-1" offset="0.0" s="8.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="lead_npc">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-1" offset="0.0" s="46.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="5.5"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="cut_in_npc">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-2" offset="0.0" s="28.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="5.5"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="sidewalk_walker">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="1" laneId="-2" offset="-2.2" s="65.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="1.4"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="AutowareCutInStory">
            <Act name="CutInAndAccelerateAct">
                <ManeuverGroup maximumExecutionCount="1" name="CutInManeuverGroup">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="cut_in_npc"/>
                    </Actors>
                    <Maneuver name="CutInManeuver">
                        <Event name="CutInWhenEgoApproachesEvent" priority="overwrite">
                            <Action name="CutInLaneChangeAction">
                                <PrivateAction>
                                    <LateralAction>
                                        <LaneChangeAction>
                                            <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="2.0" dynamicsDimension="time"/>
                                            <LaneChangeTarget>
                                                <AbsoluteTargetLane value="-1"/>
                                            </LaneChangeTarget>
                                        </LaneChangeAction>
                                    </LateralAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="EgoApproachesCutInCondition" delay="0.0" conditionEdge="rising">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="ego"/>
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <RelativeDistanceCondition entityRef="cut_in_npc"
                                                                           relativeDistanceType="longitudinal"
                                                                           value="19.0"
                                                                           freespace="false"
                                                                           rule="lessThan"/>
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                        <Event name="CutInAccelerateAfterMergeEvent" priority="overwrite">
                            <Action name="CutInAccelerateAction">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="4.0" dynamicsDimension="rate"/>
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="$CutInSpeed"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="CutInMergeCompleteCondition" delay="0.0" conditionEdge="rising">
                                        <ByValueCondition>
                                            <StoryboardElementStateCondition storyboardElementType="action"
                                                                             storyboardElementRef="CutInLaneChangeAction"
                                                                             state="completeState"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <ManeuverGroup maximumExecutionCount="1" name="LeadVehicleManeuverGroup">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="lead_npc"/>
                    </Actors>
                    <Maneuver name="LeadAccelerateManeuver">
                        <Event name="LeadAcceleratesWhenEgoClosesGapEvent" priority="overwrite">
                            <Action name="LeadSpeedUpAction">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="5.0" dynamicsDimension="rate"/>
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="$LeadTargetSpeed"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="EgoApproachesLeadCondition" delay="0.0" conditionEdge="rising">
                                        <ByEntityCondition>
                                            <TriggeringEntities triggeringEntitiesRule="any">
                                                <EntityRef entityRef="ego"/>
                                            </TriggeringEntities>
                                            <EntityCondition>
                                                <RelativeDistanceCondition entityRef="lead_npc"
                                                                           relativeDistanceType="longitudinal"
                                                                           value="$TriggerDistance"
                                                                           freespace="false"
                                                                           rule="lessThan"/>
                                            </EntityCondition>
                                        </ByEntityCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="ActStartCondition" delay="0.0" conditionEdge="none">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0.0" rule="greaterOrEqual"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="ScenarioStopCondition" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                        <SimulationTimeCondition value="60.0" rule="greaterThan"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
